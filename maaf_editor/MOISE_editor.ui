      <widget class="QWidget" name="tab_welcome">
       <attribute name="title">
        <string>MOISE+</string>
       </attribute>
       <layout class="QGridLayout" name="gridLayout">
        <item row="0" column="0">
         <widget class="QLabel" name="label_31">
          <property name="text">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;Welcome to &lt;/span&gt;&lt;a href=&quot;Moise — Organisation Oriented Programming Framework&quot;&gt;&lt;span style=&quot; font-size:12pt; text-decoration: underline; color:#0000ff;&quot;&gt;MOISE+ GUI&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;br/&gt;MOISE+ GUI is a graphical tool for specifying multi-agent organizations using the MOISE+ framework. It is a cross-platform, Qt-based desktop application that lets you visually create, edit, and validate multi-agent organizational models.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;It structures the model into three views:&lt;br/&gt;– &lt;span style=&quot; font-weight:600;&quot;&gt;Structural:&lt;/span&gt; defines the static organization structure with Roles (agent positions and their attributes), Relations (links indicating authority or dependency), and Groups (collections of roles working together)&lt;br/&gt;– &lt;span style=&quot; font-weight:600;&quot;&gt;Functional:&lt;/span&gt; captures agent behaviors through Goals (objectives agents aim to achieve), Plans (ordered sequences of actions to fulfill goals), and Missions (sets of goals composing higher-level tasks)&lt;br/&gt;– &lt;span style=&quot; font-weight:600;&quot;&gt;Deontic:&lt;/span&gt; governs normative rules by specifying Permissions (allowed actions for roles) and Obligations (required actions roles must perform)&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;Key papers:&lt;br/&gt;– &lt;a href=&quot;https://doi.org/10.1504/IJAOSE.2007.016266&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;Developing organised multi-agent systems using the MOISE+ model: Programming issues at the system and agent levels (International Journal of Agent-Oriented Software Engineering, 1(3/4):370–395, 2007)&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <spacer name="verticalSpacer">
          <property name="orientation">
           <enum>Qt::Vertical</enum>
          </property>
